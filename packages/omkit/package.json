{
  "name": "omkit",
  "version": "0.4.8",
  "description": "A tiny runtime for developer workflows: typed actions that pass runtime capabilities and emit typed events, under one run and one shared log. The operational/runtime layer to tskb's knowledge layer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "omkit": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "author": "Dimitar Mihaylov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitk0936/tskb.git",
    "directory": "packages/omkit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "typescript",
    "orchestration",
    "actions",
    "simulation",
    "pipeline",
    "process",
    "watch",
    "logging",
    "developer-tools"
  ],
  "dependencies": {
    "ink": "^7.1.1",
    "patch-console": "^2.0.0",
    "playwright-core": "^1.49.0",
    "react": "^19.2.8",
    "tsx": "4.23.1",
    "zod": "^4.4.3",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
